# Server-only environment. Docker Compose 2.30+ reads this as raw key=value.
# Do not wrap scalar secrets in quotes. Never commit the generated app.env.
DEBUG=false
DATABASE_URL=sqlite:////srv/state/app.sqlite3
CORS_ORIGINS=[]
AUTH_CHALLENGE_SECRET=
ADMIN_ACCOUNT_IDS=
ADMIN_VIEWER_ACCOUNT_IDS=
FORUM_FEATURED_LIKES=10
FORUM_BLOCKED_TERMS=["刷单返利","代办假证"]

# Optional text model; independent from the speech credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_CONCURRENCY=4
LLM_MAX_OUTPUT_TOKENS=2048
LLM_STRICT_MODE=false
RETRIEVAL_PROVIDER=bm25
EMBEDDING_PROVIDER=hash

# Enable only after configuring an authorized speech service credential.
VOICE_ENABLED=false
VOICE_ASR_PROVIDER=dummy
VOICE_TTS_PROVIDER=dummy
DOUBAO_VOICE_AUTH_MODE=api_key
DOUBAO_VOICE_API_KEY=
DOUBAO_VOICE_MODEL=1.2.6.1
DOUBAO_VOICE_SPEAKER=zh_female_xiaohe_jupiter_bigtts
DOUBAO_VOICE_TIMEOUT_SECONDS=15
DOUBAO_VOICE_SESSION_SECONDS=120
DOUBAO_VOICE_MAX_CONNECTIONS=2

# For an existing legacy speech application, set auth mode to legacy and fill both.
DOUBAO_VOICE_APP_ID=
DOUBAO_VOICE_ACCESS_TOKEN=

# Email is optional; never use the local test mailbox on a public server.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
