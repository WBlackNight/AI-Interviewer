# ===== 复制为 .env 后按需修改；全部留空也能跑（启发式模式 + SQLite）=====

# 数据库：默认 SQLite；接 Docker Compose 后切换：
# DATABASE_URL=postgresql+psycopg://interviewer:interviewer@localhost:5432/interviewer
DATABASE_URL=sqlite:///./dev.db

# LLM（OpenAI 兼容协议；不配置则使用确定性启发式组件）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_OUTPUT_TOKENS=2048
# 仅支持thinking的模型显式配置，留空时不要添加此行：
# LLM_THINKING_MODE=disabled
# 智谱文本联调的可复现配置（使用自己的服务端LLM_API_KEY）：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash-250414
# 此GLM-4模型不发送thinking字段；四组件探针通过不保证整场零回退。

# 每份简历/每场面试分别计量；面试规划与后续评分/追问共享同一账本。
# 软阈值允许单次响应越线，后续请求被阻止；0表示不限制token。
LLM_MAX_CONCURRENCY=4
LLM_BUDGET_TOKENS_PER_INTERVIEW=0
# 金额阈值必须同时配置输入/输出每百万token单价；未配置不计算金额。
# LLM_BUDGET_COST_PER_INTERVIEW=1
# LLM_PRICE_INPUT_PER_MILLION=...
# LLM_PRICE_OUTPUT_PER_MILLION=...

# 检索：默认BM25。先独立运行evals/build_question_index.py，再选择vector/hybrid。
# hash是离线词法向量基线，不是语义模型；不使用EMBEDDING_API_KEY/BASE_URL。
RETRIEVAL_PROVIDER=bm25
# 相对路径始终以项目根目录为基准，与启动目录无关。
RETRIEVAL_INDEX_PATH=data/retrieval/question_index.json
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=char-ngram-hash-v1
EMBEDDING_DIMENSIONS=256

# 智谱Embedding-3（真实语义模型，独立于LLM_API_KEY，显式替换上面的hash配置）
# EMBEDDING_PROVIDER=zhipu
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=在本地.env中填写
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_REVISION=1
# EMBEDDING_TIMEOUT_SECONDS=15
# RETRIEVAL_INDEX_PATH=data/retrieval/zhipu-multi-position-v1.json
# 构建并验证索引后选择RETRIEVAL_PROVIDER=hybrid；不能混用hash索引。

# 代码沙箱（Judge0 自部署；不配置则编码题仅主观评审）
JUDGE0_URL=
JUDGE0_API_KEY=
SANDBOX_MAX_CONCURRENCY=2
SANDBOX_MAX_WAITERS=8
SANDBOX_QUEUE_TIMEOUT_SECONDS=2
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_RESPONSE_BYTES=262144
SANDBOX_MAX_TESTCASES=12

# 面试策略
PASS_SCORE=7.0
PROBE_SCORE=4.0
# 低于 PROBE_SCORE 先问基础；达到该分但未通过时深挖；两者都受深度上限约束
PROBE_DEPTH_LIMIT=3
MAX_PLAN_THEMES=3
WEAK_SCORE=7.0
WS_MAX_MESSAGE_BYTES=100000
WS_IDLE_TIMEOUT_SECONDS=300
TURN_TIMEOUT_SECONDS=180

# PDF简历：默认5MiB、10页、20000字符；提取子进程超时后终止，不支持OCR
RESUME_PDF_MAX_BYTES=5242880
RESUME_PDF_MAX_PAGES=10
RESUME_PDF_MAX_TEXT_CHARS=20000
RESUME_PDF_TIMEOUT_SECONDS=10
RESUME_UPLOAD_TIMEOUT_SECONDS=30

# 跨域（前端地址）
CORS_ORIGINS=["http://localhost:3000"]

# 账户验证码：多进程/重启保留待验证请求时，配置至少32字符的随机密钥。
# 不配置则使用进程内随机密钥，重启后未完成的验证码失效。
# AUTH_CHALLENGE_SECRET=在本地生成至少32字符的随机密钥
# 邮件默认关闭；隔离预览加--local-mail即可启动本机SMTP1025/收件箱8025。
# 真实发信选择smtp并填写自己的服务配置，必须使用starttls或ssl。
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=在本地填写
# SMTP_PASSWORD=在本地填写
# MAIL_FROM=your-address@example.com

# 豆包实时语音Seeduplex：只在后端填写语音控制台Key，勿复用方舟文本Key。
# 配置存在不表示鉴权或识别质量通过；默认关闭，先运行独立探针。
VOICE_ENABLED=false
VOICE_ASR_PROVIDER=dummy
VOICE_TTS_PROVIDER=dummy
DOUBAO_VOICE_API_KEY=
DOUBAO_VOICE_AUTH_MODE=api_key
# 旧版控制台另选legacy，只使用同一应用的APP ID和Access Token，不使用Secret Key：
# DOUBAO_VOICE_AUTH_MODE=legacy
# DOUBAO_VOICE_APP_ID=在本地填写数字应用ID
# DOUBAO_VOICE_ACCESS_TOKEN=在本地填写Access Token
DOUBAO_VOICE_MODEL=1.2.6.1
DOUBAO_VOICE_SPEAKER=zh_female_xiaohe_jupiter_bigtts
DOUBAO_VOICE_TIMEOUT_SECONDS=15
DOUBAO_VOICE_SESSION_SECONDS=120
DOUBAO_VOICE_MAX_CONNECTIONS=2
# 真实鉴权通过后显式改为：
# VOICE_ENABLED=true
# VOICE_ASR_PROVIDER=doubao
# VOICE_TTS_PROVIDER=doubao
